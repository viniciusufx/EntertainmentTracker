{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Cookies": {
      "AccessTokenName": "access_token",
      "RefreshTokenName": "refresh_token",
      "HttpOnly": true,
      "Secure": true,
      "SameSite": "Strict",
      "AccessTokenExpirationMinutes": 15,
      "RefreshTokenExpirationDays": 7
    }
  },
  "RsaSecurity": {
    "PrivateKey": "",
    "PublicKey": ""
  },
  "JwtSecurity": {
    "Issuer": "EntertainmentTracker",
    "Audience": "EntertainmentTracker.Api",
    "ExpirationMinutes": 15
  },
  "Security": {
    "Password": {
      "Pepper": "",
      "MemorySize": 0,
      "Iterations": 0,
      "DegreeOfParallelism": 0,
      "SaltSize": 0,
      "HashSize": 0
    }
  },
  "AllowedHosts": "*"
}
